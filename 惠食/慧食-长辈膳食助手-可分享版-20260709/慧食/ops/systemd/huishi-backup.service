[Unit]
Description=Create encrypted Huishi database backup
After=huishi.service

[Service]
Type=oneshot
User=huishi
Group=huishi
WorkingDirectory=/opt/huishi
EnvironmentFile=/etc/huishi/huishi.env
ExecStart=/usr/bin/node /opt/huishi/ops/backup.js
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/huishi /var/backups/huishi
StandardOutput=journal
StandardError=journal
SyslogIdentifier=huishi-backup
