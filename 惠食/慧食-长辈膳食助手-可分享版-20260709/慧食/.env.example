# Server
HOST=127.0.0.1
PORT=8787
API_RATE_LIMIT=30
UPSTREAM_TIMEOUT_MS=18000

# Local Ollama-compatible model
LOCAL_MODEL_BASE_URL=
LOCAL_MODEL=qwen3-vl:8b

# Local whisper.cpp transcription
WHISPER_COMMAND=
WHISPER_MODEL=
WHISPER_LIBRARY_PATH=
FFMPEG_COMMAND=/usr/bin/ffmpeg

# OpenAI-compatible cloud providers. Leave unused credentials empty.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_PHOTO_MEAL_MODEL=gpt-4o

OMINIGATE_API_KEY=
OMINIGATE_BASE_URL=https://api.ominigate.ai/v1
OMINIGATE_TEXT_MODEL=openai/gpt-4o-mini
OMINIGATE_VISION_MODEL=openai/gpt-4o
OMINIGATE_PHOTO_MEAL_MODEL=openai/gpt-4o

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_PHOTO_MEAL_MODEL=google/gemma-4-26b-a4b-it:free

