# Server
HOST=127.0.0.1
PORT=8787

# Account database and session security. Production AUTH_SECRET must contain
# at least 32 random characters and must never be committed to GitHub.
NODE_ENV=development
AUTH_DB_PATH=./data/huishi.sqlite
AUTH_SECRET=
COOKIE_SECURE=auto
TRUST_PROXY=false

# Test builds default to password-only registration and do not expose password
# recovery unless a real SMS provider is configured. Production always requires SMS.
SMS_PROVIDER=disabled
AUTH_DEV_MODE=true
# Required when password-only registration is intentionally exposed on a
# non-loopback pilot server. Password recovery remains unavailable without SMS.
PUBLIC_PILOT_ACKNOWLEDGED=false
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

# Phone/name/ID three-element verification. Raw ID numbers are never stored.
IDENTITY_VERIFICATION_REQUIRED=false
IDENTITY_PROVIDER=disabled
IDENTITY_WEBHOOK_URL=
IDENTITY_WEBHOOK_TOKEN=
API_RATE_LIMIT=30
UPSTREAM_TIMEOUT_MS=18000

# Production refuses to start without photo analysis by default. Set this only
# when the product intentionally ships with the photo path visibly disabled.
ALLOW_PHOTO_DISABLED=false
# Optional: require server-side Whisper instead of relying on browser speech.
REQUIRE_SERVER_SPEECH=false

# Local Ollama-compatible model
LOCAL_MODEL_BASE_URL=
LOCAL_MODEL=qwen3-vl:8b

# Local whisper.cpp transcription
WHISPER_COMMAND=
WHISPER_MODEL=
WHISPER_LIBRARY_PATH=
FFMPEG_COMMAND=/usr/bin/ffmpeg

# OpenAI-compatible cloud providers. Leave unused credentials empty.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_PHOTO_MEAL_MODEL=gpt-4o

OMINIGATE_API_KEY=
OMINIGATE_BASE_URL=https://api.ominigate.ai/v1
OMINIGATE_TEXT_MODEL=openai/gpt-4o-mini
OMINIGATE_VISION_MODEL=openai/gpt-4o
OMINIGATE_PHOTO_MEAL_MODEL=openai/gpt-4o

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_PHOTO_MEAL_MODEL=google/gemma-4-26b-a4b-it:free
